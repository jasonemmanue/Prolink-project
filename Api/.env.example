ENVIRONMENT=dev
# En Docker, DATABASE_URL est fourni par docker-compose.yml (hôte "db").
DATABASE_URL=postgresql+psycopg2://prolink:prolink@localhost:5432/prolink
TEST_DATABASE_URL=postgresql+psycopg2://prolink:prolink@localhost:5432/prolink_test
JWT_SECRET=change-me
SEED_DEMO=true
OTP_DEV_ECHO=true
CORS_ORIGINS=["http://localhost:3000","*"]

# Règles produit (surchargées ensuite depuis le back-office)
COMMISSION_SERVICE_PCT=10
COMMISSION_LIVE_PCT=15
COMMISSION_TIP_PCT=10
TWO_FA_MONTHLY_THRESHOLD_XAF=100000
WALLET_MIN_BALANCE_XAF=500

# Vides = mode sandbox / dev
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
FIREBASE_PROJECT_ID=
TRANSLATION_PROVIDER=libretranslate
TRANSLATION_BASE_URL=https://libretranslate.de
